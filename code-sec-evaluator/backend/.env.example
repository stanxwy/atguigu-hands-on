# =============================================================================
# 自动化安全评估系统 — 后端环境变量示例（复制为 .env 后填写真实值）
# 说明：.env 不入仓（见《安全规范》§4.3 密钥管理），本文件仅提供占位符。
# =============================================================================

# JWT 签名密钥（必填，缺失即拒绝启动；≥32 字节随机串）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-64-char-secret-key

# 数据库连接串：开发默认 SQLite（异步），生产切换为 MySQL（PyMySQL）
# 例：mysql+pymysql://user:pass@127.0.0.1:3306/code_sec_evaluator?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 访问令牌有效期（分钟），默认 24 小时，可经 system_config 调整
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 工作区 / 报告 / 运行日志根目录（相对 backend/ 或绝对路径）
WORKSPACE_ROOT=./workspace
REPORT_ROOT=./reports
LOG_ROOT=./runtime_logs

# 隔离环境默认镜像（作为 system_config 种子与兜底）
ISOLATION_DEFAULT_IMAGE=sec-evaluator:latest
ISOLATION_MOUNT_READONLY=true
ISOLATION_NETWORK_MODE=none
# 是否使用本地回退（true=不创建 Docker 容器，直接宿主机只读扫描，仅开发/演示用；
# 生产必须设为 false 以启用容器隔离）
ISOLATION_FALLBACK_LOCAL=false

# 任务默认超时（秒）与最大并行评估项目数
TASK_DEFAULT_TIMEOUT_SECONDS=1800
TASK_MAX_CONCURRENCY=2

# 已完成项目文件保留天数
RETENTION_DAYS=30

# ---- LLM 语义分析（默认关闭；开启后作为规则预筛之上的增强层）----
# 总开关：false=纯规则模式（AC-7 演示闭环不受影响）；true=启用 LLM 增强
LLM_ENABLED=false
# OpenAI 兼容端点（openai/qwen/deepseek/ollama 均可，如 http://localhost:11434/v1）
LLM_BASE_URL=
# 模型名
LLM_MODEL=
# 密钥（仅存 .env/环境变量，不入库、不入日志）
LLM_API_KEY=
# 单次调用超时（秒）与失败重试次数
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# 跨域来源（逗号分隔的 JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
